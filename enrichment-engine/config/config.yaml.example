  verify_ssl: false

thresholds:
  block_score: 75
  review_score: 50

alerts:
  watch_file: "/var/ossec/logs/alerts/alerts.json"

logging:
  file: "/home/wazuhuser/enrichment-engine/logs/enrichment.log"
  level: "INFO"
