abuseipdb:
  api_key: "YOUR_ABUSEIPDB_KEY_HERE"
  url: "https://api.abuseipdb.com/api/v2/check"
  max_age_days: 90

otx:
  api_key: "YOUR_OTX_KEY_HERE"
  url: "https://otx.alienvault.com/api/v1"

misp:
  api_key: "YOUR_MISP_KEY_HERE"
